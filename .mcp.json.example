{
  "mcpServers": {
    "langfuse": {
      "command": "node",
      "args": ["/absolute/path/to/mcp-langfuse/dist/cli.js"],
      "env": {
        "LANGFUSE_HOST": "https://cloud.langfuse.com",
        "LANGFUSE_PUBLIC_KEY": "pk-lf-...",
        "LANGFUSE_SECRET_KEY": "sk-lf-...",
        "LANGFUSE_PROJECT": "my-project"
      }
    }
  }
}
