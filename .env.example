# ── Instance ─────────────────────────────────────────────────────────────────
# The Langfuse that issued the keys. Defaults to the keys file's `host`, then
# https://cloud.langfuse.com. (LANGFUSE_BASE_URL is accepted as an alias.)
LANGFUSE_HOST=

# ── Keys: one per project ────────────────────────────────────────────────────
# Langfuse keys are project-scoped; this server holds one per project and every
# data tool takes a `project` argument. Three sources, merged by name, earlier
# wins:
#
# 1. A single project's pair, filed under LANGFUSE_PROJECT (name or id). Without
#    LANGFUSE_PROJECT it is served unchecked as "default", and only when it is
#    the sole project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT=

# 2. A JSON map of name → pair: {"sales":{"publicKey":"pk-lf-…","secretKey":"sk-lf-…"}}
LANGFUSE_PROJECTS=

# 3. The keys file `pnpm provision` writes. Defaults to
#    ~/.config/langfuse-mcp/keys.json.
LANGFUSE_KEYS_FILE=

# An organization key does NOT work here: on every plan those reach only the
# org management API, never traces, observations, scores or metrics.

# ── Provisioning (pnpm provision only — the server never reads these) ────────
# Langfuse's own Postgres (e.g. through a port-forward) and the SALT of the
# RUNNING langfuse-web, read from the deployment rather than a local secrets copy.
LANGFUSE_DB_URL=
LANGFUSE_SALT=

# ── Safety ───────────────────────────────────────────────────────────────────
# Set to 1 to let langfuse_request send POST/PUT/PATCH/DELETE. Every named tool
# is a read; this flag only widens the escape hatch.
LANGFUSE_ALLOW_WRITES=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Retry budget for 429 / 5xx responses. Defaults to 3.
LANGFUSE_MAX_RETRIES=3

# Set to 1 to log each request to stderr.
LANGFUSE_DEBUG=
